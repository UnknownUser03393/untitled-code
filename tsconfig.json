{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "src/*": ["./src/*"],
            "bun:bundle": ["./src/polyfills/bunBundle.ts"],
            "bun:ffi": ["./src/polyfills/bunFFI.ts"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
